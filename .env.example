# Run Mosaic on loopback only. Do not expose the local API to a public network.
MOSAIC_HOST=127.0.0.1
MOSAIC_PORT=8765
MOSAIC_DATA_DIR=./data
MOSAIC_MAX_UPLOAD_BYTES=104857600
MOSAIC_MAX_ARCHIVE_ENTRIES=2500
MOSAIC_MAX_ARCHIVE_UNCOMPRESSED_BYTES=524288000
MOSAIC_MAX_ARCHIVE_ENTRY_BYTES=209715200
MOSAIC_MAX_COMPRESSION_RATIO=200
MOSAIC_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MOSAIC_OLLAMA_BASE_URL=http://127.0.0.1:11434
MOSAIC_OLLAMA_MODEL=
